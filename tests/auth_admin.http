### Request OTP
POST http://127.0.0.1:8005/auth/request-otp
Content-Type: application/json

{"email": "adm.in@gmail.com"}

### Verify OTP
POST http://127.0.0.1:8005/auth/verify-otp
Content-Type: application/json

{"email": "adm.in@gmail.com", "otp": "123456"}

### Get current user
GET http://127.0.0.1:8005/auth/me
Authorization: Bearer <token>

### Create staff
POST http://127.0.0.1:8005/admin/users
Authorization: Bearer <token>
Content-Type: application/json

{"name": "Kitchen Staff", "email": "kitchen.staff@example.com", "role": "kitchen"}

### List staff
GET http://127.0.0.1:8005/admin/users?page=1&page_size=20&role=admin
Authorization: Bearer <token>

### Get staff by id
GET http://127.0.0.1:8005/admin/users/2
Authorization: Bearer <token>

### Update staff
PUT http://127.0.0.1:8005/admin/users/2
Authorization: Bearer <token>
Content-Type: application/json

{"name": "Updated Kitchen", "role": "kitchen"}

### Delete staff
DELETE http://127.0.0.1:8005/admin/users/2
Authorization: Bearer <token>

### Create customer session
POST http://127.0.0.1:8005/customer/session
Content-Type: application/json

{"name": "John Doe", "email": "john.doe@example.com", "number_of_people": 4, "table_number": 8}

### Get customer session by id
GET http://127.0.0.1:8005/customer/session/1

### Update customer session by id
PUT http://127.0.0.1:8005/customer/session/1
Content-Type: application/json

{"name": "John Doe", "email": "john.doe@example.com", "number_of_people": 5, "table_number": 8}

### Create category (admin only)
POST http://127.0.0.1:8005/categories
Authorization: Bearer <token>
Content-Type: application/json

{"name": "Starters", "description": "Appetizers and small plates"}

### List categories (public)
GET http://127.0.0.1:8005/categories?page=1&page_size=20

### Search categories (public)
GET http://127.0.0.1:8005/categories?page=1&page_size=20&search=starter

### Get category by id (public)
GET http://127.0.0.1:8005/categories/1

### Update category (admin only)
PUT http://127.0.0.1:8005/categories/1
Authorization: Bearer <token>
Content-Type: application/json

{"name": "Updated Starters", "description": "Updated appetizer selection"}

### Delete category (admin only)
DELETE http://127.0.0.1:8005/categories/1
Authorization: Bearer <token>

### Create menu item (admin only; category_id must exist)
POST http://127.0.0.1:8005/menu
Authorization: Bearer <token>
Content-Type: multipart/form-data; boundary=MenuBoundary

--MenuBoundary
Content-Disposition: form-data; name="category_id"

1
--MenuBoundary
Content-Disposition: form-data; name="name"

Paneer Tikka
--MenuBoundary
Content-Disposition: form-data; name="description"

Grilled cottage cheese with spices
--MenuBoundary
Content-Disposition: form-data; name="price"

249.00
--MenuBoundary
Content-Disposition: form-data; name="calories"

320
--MenuBoundary
Content-Disposition: form-data; name="cook_time"

20
--MenuBoundary
Content-Disposition: form-data; name="availability"

true
--MenuBoundary
Content-Disposition: form-data; name="chef_special"

true
--MenuBoundary
Content-Disposition: form-data; name="best_seller"

false
--MenuBoundary--

### List available menu items (public)
GET http://127.0.0.1:8005/menu?page=1&page_size=20&sort_by=name&sort_dir=asc

### Filter menu items by category and chef special (public)
GET http://127.0.0.1:8005/menu?page=1&page_size=20&category_id=1&chef_special=true

### Search menu items by name (public)
GET http://127.0.0.1:8005/menu/search?query=paneer

### Get menu item by id (public)
GET http://127.0.0.1:8005/menu/1

### Get available menu items by category (public)
GET http://127.0.0.1:8005/menu/category/1

### Update menu item (admin only)
PUT http://127.0.0.1:8005/menu/1
Authorization: Bearer <token>
Content-Type: multipart/form-data; boundary=MenuBoundary

--MenuBoundary
Content-Disposition: form-data; name="price"

269.00
--MenuBoundary
Content-Disposition: form-data; name="best_seller"

true
--MenuBoundary--

### Delete menu item (admin only)
DELETE http://127.0.0.1:8005/menu/1
Authorization: Bearer <token>

### cURL examples
# curl -X POST http://127.0.0.1:8005/customer/session -H "Content-Type: application/json" -d '{"name":"John Doe","email":"john.doe@example.com","number_of_people":4,"table_number":8}'
# curl -X GET http://127.0.0.1:8005/customer/session/1
# curl -X PUT http://127.0.0.1:8005/customer/session/1 -H "Content-Type: application/json" -d '{"number_of_people":5}'
